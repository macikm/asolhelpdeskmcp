# Port pro MCP server (uvnitř kontejneru i namapovaný ven)
PORT=8095
HOST=0.0.0.0

# URL Helpdesk API a OAuth2 Identity Provideru
API_URL=https://avaplace.com/api/asoleu/helpdesk
AUTH_URL=https://avaplace.com/api/asol/idp/connect/token

# Volitelný výchozí účet (pokud nechcete, aby se kolegové museli přihlašovat)
# Pokud necháte prázdné, uživatelé se přihlašují svými údaji (přes hlavičky nebo helpdesk_login)
HELPDESK_DEFAULT_USER=
HELPDESK_DEFAULT_PASSWORD=
